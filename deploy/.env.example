# SPDX-License-Identifier: AGPL-3.0-or-later
# Copy to .env next to compose.yaml and adjust.

# Public address of the board, exactly as visitors type it.
POSTMODEM_PUBLIC_URL=https://forum.example.org
# Hostname Caddy requests a certificate for.
POSTMODEM_DOMAIN=forum.example.org

# Image to run. Pin a version in production, e.g. ghcr.io/postmodem-bbs/postmodem:1.0
POSTMODEM_IMAGE=ghcr.io/postmodem-bbs/postmodem:edge

# POSTMODEM_WEB_REPLICAS=2
# POSTMODEM_LOG_LEVEL=info
# POSTMODEM_HTTP_PORT=80
# POSTMODEM_HTTPS_PORT=443

# Outgoing mail (account confirmation, password reset). log:// only writes it to the log.
# POSTMODEM_MAIL_URL=smtp://user:password@mail.example.org:587
# POSTMODEM_MAIL_FROM="Our Board" <noreply@forum.example.org>

# Registrations one IP address may make per hour before delays start (0 = unlimited).
# POSTMODEM_REGISTRATIONS_PER_IP_HOUR=10
