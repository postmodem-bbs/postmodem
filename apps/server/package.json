{
  "name": "@postmodem/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "bin": {
    "postmodem": "build/postmodem.js"
  },
  "scripts": {
    "dev": "POSTMODEM_DATA_DIR=${POSTMODEM_DATA_DIR:-../../var/data} vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build && node scripts/build-cli.mjs",
    "start": "node build/postmodem.js run",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@postmodem/core": "workspace:*",
    "@postmodem/db": "workspace:*",
    "@postmodem/i18n": "workspace:*",
    "@postmodem/importer": "workspace:*",
    "@postmodem/markup": "workspace:*",
    "@postmodem/modules": "workspace:*",
    "@postmodem/ui": "workspace:*",
    "iovalkey": "0.4.0",
    "nodemailer": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "vite": "8.3.8"
  }
}
