// SPDX-License-Identifier: AGPL-3.0-or-later
// Same toolchain as deploy/dev/compose.dev.yaml (CONTAINERS.md §5.2): Docker is the only host requirement.
{
  "name": "Postmodem",
  "dockerComposeFile": ["../deploy/dev/compose.dev.yaml", "compose.devcontainer.yaml"],
  "service": "app",
  "workspaceFolder": "/src",
  "shutdownAction": "stopCompose",
  "forwardPorts": [5173, 8025],
  "portsAttributes": {
    "5173": { "label": "Board (Vite dev server)" },
    "8025": { "label": "Mailpit" }
  },
  "postStartCommand": "pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["svelte.svelte-vscode", "biomejs.biome", "vitest.explorer", "ms-playwright.playwright"],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" }
      }
    }
  }
}
